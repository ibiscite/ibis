{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**/*.ts", "src/**/*.tsx", "canvas/**/*.ts", "canvas/**/*.tsx", "vite.canvas.config.ts"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      }
    }
  },
  "overrides": [{
    "includes": ["src/ui/**", "!src/ui/**/*.test.ts", "!src/ui/**/*.test.tsx"],
    "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": { "patterns": [{
      "group": ["**/features/**", "**/settings/**", "**/App", "**/App.*"],
      "message": "ui/ parts can't depend on screens: move the shared piece into ui/ or pass it as a prop."
    }] } } } } }
  }]
}

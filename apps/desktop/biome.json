{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**/*.ts", "src/**/*.tsx", "canvas/**/*.ts", "canvas/**/*.tsx", "vite.canvas.config.ts"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": { "paths": { "@tauri-apps/api/event": { "importNames": ["listen", "once"], "message": "Subscribe through events, listening or useNativeEvent in src/nativeEvents.ts." } } }
        }
      }
    }
  },
  "overrides": [
    { "includes": ["src/nativeEvents.ts", "src/**/*.test.*", "src/testing/**"], "linter": { "rules": { "style": { "noRestrictedImports": "off" } } } },
    {
      "includes": ["src/ui/**", "!src/ui/**/*.test.ts", "!src/ui/**/*.test.tsx"],
      "linter": { "rules": { "style": { "noRestrictedImports": { "level": "error", "options": {
        "paths": { "@tauri-apps/api/event": { "importNames": ["listen", "once"], "message": "Subscribe through events, listening or useNativeEvent in src/nativeEvents.ts." } },
        "patterns": [{ "group": ["**/features/**", "**/settings/**", "**/App", "**/App.*"], "message": "ui/ parts can't depend on screens: move the shared piece into ui/ or pass it as a prop." }]
      } } } } }
    }
  ]
}

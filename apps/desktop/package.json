{
  "name": "ibis-desktop",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:canvas": "vite build --config vite.canvas.config.ts",
    "canvas": "vite build --config vite.canvas.config.ts && node gallery/canvas.mjs dist-canvas dist-canvas/pictures",
    "build:pseudo": "tsc --noEmit && vite build --mode pseudolocale",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@fluent/syntax": "0.19.0",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

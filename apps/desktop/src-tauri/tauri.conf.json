{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ibis",
  "identifier": "io.github.ibiscite.ibis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ibis",
        "width": 720,
        "height": 480,
        "minWidth": 360,
        "minHeight": 320,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": false,
        "resizable": true,
        "maximizable": false,
        "skipTaskbar": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-domain-reliability --no-pings --proxy-server=http://127.0.0.1:9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/linux/512x512/io.github.ibiscite.ibis.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "icons/source/ibis.desktop",
        "files": {
          "/usr/share/icons/hicolor/128x128/apps/io.github.ibiscite.ibis.png": "icons/linux/128x128/io.github.ibiscite.ibis.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.ibiscite.ibis.png": "icons/linux/256x256/io.github.ibiscite.ibis.png",
          "/usr/share/icons/hicolor/512x512/apps/io.github.ibiscite.ibis.png": "icons/linux/512x512/io.github.ibiscite.ibis.png",
          "/usr/share/icons/hicolor/symbolic/apps/io.github.ibiscite.ibis-symbolic.svg": "icons/source/io.github.ibiscite.ibis-symbolic.svg"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/128x128/apps/io.github.ibiscite.ibis.png": "icons/linux/128x128/io.github.ibiscite.ibis.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.ibiscite.ibis.png": "icons/linux/256x256/io.github.ibiscite.ibis.png",
          "/usr/share/icons/hicolor/512x512/apps/io.github.ibiscite.ibis.png": "icons/linux/512x512/io.github.ibiscite.ibis.png",
          "/usr/share/icons/hicolor/symbolic/apps/io.github.ibiscite.ibis-symbolic.svg": "icons/source/io.github.ibiscite.ibis-symbolic.svg"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RDQyOTVCRjYyNzM0N0MKUldSOE5DZjJXeW5VUldibkJiL3JLdmVGVUFaRGQ5cGtTb3NDdUZPLzg4bjF4c3N1TEtuTEFZVmwK",
      "endpoints": [
        "https://github.com/ibiscite/ibis/releases/download/stable/latest.json"
      ]
    }
  }
}

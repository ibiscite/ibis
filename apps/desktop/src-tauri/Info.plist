<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The interface languages (locales/*.ftl), so macOS lists Ibis under
       Language & Region › Applications and words its own dialogs to match. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>de</string>
    <string>ar</string>
  </array>
  <key>CFBundleIconName</key>
  <string>Ibis</string>
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Search with Ibis</string>
      </dict>
      <key>NSMessage</key>
      <string>searchWithIbis</string>
      <key>NSPortName</key>
      <string>Ibis</string>
      <key>NSSendTypes</key>
      <array>
        <string>public.utf8-plain-text</string>
      </array>
    </dict>
  </array>
</dict>
</plist>

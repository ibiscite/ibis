{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Picker commands, event subscriptions, visibility reads and drag-region bootstrap for the main window. No file system, shell, network, menu or tray plugin access is granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-visible",
    "core:window:allow-start-dragging",
    "allow-choose-library",
    "allow-reload-library",
    "allow-use-zotero",
    "allow-use-sample-library",
    "allow-find-sources",
    "allow-open-found-library",
    "allow-use-zotero-libraries",
    "allow-zotero-groups",
    "allow-library-status",
    "allow-search",
    "allow-preview-file-citation",
    "allow-copy-file-citation",
    "allow-copy-format",
    "allow-picker-preferences",
    "allow-preference-revision",
    "allow-set-picker-preferences",
    "allow-picker-destination",
    "allow-remember-app-output",
    "allow-forget-app-outputs",
    "allow-login-item",
    "allow-set-login-item",
    "allow-hide-picker",
    "allow-picker-presentation",
    "allow-set-pinned",
    "allow-quit",
    "allow-shortcut-status",
    "allow-show-copied-notice",
    "allow-native-appearance",
    "allow-row-context",
    "allow-update-checks",
    "allow-set-update-checks",
    "allow-check-for-updates",
    "allow-update-available",
    "allow-update-picker-activity",
    "allow-open-settings",
    "allow-read-window-position-undo",
    "allow-undo-window-position",
    "allow-dismiss-window-position-undo"
  ]
}

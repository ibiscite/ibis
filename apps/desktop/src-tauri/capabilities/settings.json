{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: read and change saved choices, the login item, update checks, the paste permission and the shortcut, and back up or restore settings through system file dialogs, and switch the loopback editor endpoint on or off and copy its address. No library, copy, file system or shell access, and no network beyond that one 127.0.0.1 listener.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "allow-picker-preferences",
    "allow-preference-revision",
    "allow-editor-endpoint",
    "allow-set-editor-endpoint",
    "allow-copy-editor-endpoint",
    "allow-delight-view",
    "allow-set-picker-preferences",
    "allow-window-size",
    "allow-set-window-size",
    "allow-login-item",
    "allow-set-login-item",
    "allow-update-checks",
    "allow-set-update-checks",
    "allow-check-for-updates",
    "allow-open-about-link",
    "allow-paste-permission",
    "allow-open-paste-permission",
    "allow-drag-paste-app",
    "allow-finish-paste-guide",
    "allow-shortcut-status",
    "allow-set-shortcut",
    "allow-configure-shortcuts",
    "allow-back-up-settings",
    "allow-choose-settings-backup",
    "allow-restore-settings-backup",
    "allow-cancel-settings-restore"
  ]
}

{
  description = "Ibis command line and Linux desktop app";

  # nixos-26.05, pinned even when flake.lock is generated by the consumer or CI.
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/ac588ef1c914865dad517b337ea0eb9694a4021c";

  outputs = { self, nixpkgs, ... }:
    let
      inherit (nixpkgs) lib;
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];
      forAllSystems = lib.genAttrs systems;
    in {
      packages = forAllSystems (system:
        let
          pkgs = import nixpkgs { inherit system; };
          ibis = pkgs.rustPlatform.buildRustPackage {
            pname = "ibis";
            version = (builtins.fromTOML (builtins.readFile ./Cargo.toml)).workspace.package.version;
            src = import ./nix/source.nix { inherit lib; };
            cargoLock.lockFile = ./Cargo.lock;
            cargoBuildFlags = [ "--package" "ibis" "--bin" "ibis" ];
            cargoTestFlags = [ "--package" "ibis" ];
            nativeBuildInputs = [ pkgs.installShellFiles ];
            postInstall = ''
              installShellCompletion --cmd ibis \
                --bash <("$out/bin/ibis" completions bash) \
                --zsh <("$out/bin/ibis" completions zsh) \
                --fish <("$out/bin/ibis" completions fish)
            '';
            meta = {
              description = "Search reference libraries and prepare citations from the command line";
              homepage = "https://github.com/ibiscite/ibis";
              license = lib.licenses.agpl3Plus;
              mainProgram = "ibis";
              platforms = systems;
            };
          };
        in {
          inherit ibis;
          default = ibis;
        } // lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
          ibis-desktop = pkgs.callPackage ./nix/package.nix { };
        });
      checks = forAllSystems (system:
        let pkgs = import nixpkgs { inherit system; };
        in lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
          ibis-desktop = pkgs.callPackage ./nix/checks.nix {
            ibis-desktop = self.packages.${system}.ibis-desktop;
          };
        });
    };
}

+#[test]
+#[ignore = "10k fixture; deterministic source-selection ownership scenarios"]
+fn delayed_a_cannot_replace_b_or_survive_close() {
+    let session = FileCacheSession::default();
+    session.invalidate(1);
+    let first = empty().prepare_file_load(&input(), false, session.operation(1), &Cancellation::default()).unwrap();
+    session.invalidate(2);
+    let second = empty().prepare_file_load(&input(), false, session.operation(2), &Cancellation::default()).unwrap();
+    let accepted = second.engine().unwrap();
+    accepted.accept_file_load(second).unwrap();
+    let stale = first.engine().unwrap();
+    assert_eq!(stale.accept_file_load(first).unwrap_err().code, ErrorCode::Cancelled);
+    check_records(&accepted, 10_000, 1534, false).unwrap();
+    session.close();
+    assert!(empty().prepare_file_load(&input(), false, session.operation(2), &Cancellation::default()).is_err());
+    assert_eq!(oracle(&accepted), oracle(&uncached(&input())));
+}

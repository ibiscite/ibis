+"""Offline stage B: retained binaries, original oracles, counterbalanced runs.
+
+Use the conda base Python. All builds and optional raw sample traces stay in
+target. Published evidence contains only invented data and numeric load/RSS.
+The predeclared baseline validity rule is max/min <= 1.25 for first-results
+and peak RSS. Invalid attempts are kept; no outliers/warmups are discarded.
+"""
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import statistics
+import subprocess
+import time
+
+from fixtures import ROOT, digest
+from instrument import build
+
+spec = importlib.util.spec_from_file_location("stage_a", Path(__file__).parent.parent / "storage_spike.py")
+stage_a = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(stage_a)
+OUT = ROOT / "target/stage-b"
+GOLDEN = ROOT / "spike-results/stage-b-original-golden.json"
+
+
+def environment(threads="1"):
+    return dict(os.environ, CARGO_TARGET_DIR=str(ROOT / "target"), CARGO_NET_OFFLINE="true",
+                IBIS_SPIKE_FIXTURE=str(ROOT / "target/stage-a-fixtures/10000"),
+                IBIS_SPIKE_CASE="bib-none", IBIS_SPIKE_RECORDS="10000", IBIS_SPIKE_SEED="1534",
+                IBIS_SPIKE_GOLDEN=str(GOLDEN), IBIS_SPIKE_THREADS=threads)
+
+
+def test(binary, name, env):
+    subprocess.run([str(binary), "--exact", f"stage_b::{name}", "--ignored", "--nocapture", "--test-threads=1"],
+                   env=env, check=True)
+
+
+def distribution(values):
+    return dict(min=min(values), median=statistics.median(values), max=max(values))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--build-label")
+    parser.add_argument("--capture", action="store_true")
+    parser.add_argument("--detail", action="store_true")
+    parser.add_argument("--check", nargs="+")
+    parser.add_argument("--profile", choices=["index", "load"])
+    parser.add_argument("--compare", nargs="+")
+    parser.add_argument("--rounds", type=int, default=5)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    os.environ.update(CARGO_TARGET_DIR=str(ROOT / "target"), CARGO_NET_OFFLINE="true")
+    OUT.mkdir(exist_ok=True)
+    manifest = json.loads((ROOT / "target/stage-a-fixtures/10000/manifest.json").read_text())
+    for path, evidence in manifest["files"].items():
+        assert digest(ROOT / "target/stage-a-fixtures/10000" / path) == evidence["sha256"]
+    if args.build_label:
+        destination = OUT / args.build_label
+        destination.mkdir()  # do not overwrite retained executables/evidence
+        binary, provenance = build(detail=args.detail)
+        shutil.copy2(binary, destination / "storage_spike")
+        (destination / "build.json").write_text(json.dumps(provenance, indent=2))
+    if args.capture:
+        env = environment()
+        env["IBIS_SPIKE_CAPTURE"] = "1"
+        test(OUT / args.build_label / "storage_spike", "realistic_oracle", env)
+    for config in args.check or []:
+        label, _, threads = config.partition(":")
+        for name in ["realistic_oracle", "delayed_a_cannot_replace_b_or_survive_close", "cancelled_stage_cannot_publish"]:
+            test(OUT / label / "storage_spike", name, environment(threads or "1"))
+        subprocess.run([str(OUT / label / "storage_spike"), "--exact", "stage_b::warning_lines_order_duplicates_and_hostile_bounds"],
+                       env=environment(threads or "1"), check=True)
+    if args.profile:
+        binary = OUT / args.build_label / "storage_spike"
+        process = subprocess.Popen([str(binary), "--exact", f"stage_b::profile_{args.profile}", "--ignored", "--nocapture"], env=environment())
+        try:
+            time.sleep(1)
+            subprocess.run(["sample", str(process.pid), "5", "1", "-file", str(OUT / f"sample-{args.profile}.txt")], check=False, timeout=15)
+        finally:
+            process.wait(timeout=20)
+    if not args.compare:
+        return
+    assert args.rounds > 0 and args.output
+    # Alternating forward/reverse order counterbalances drift; preserve every
+    # attempt. Multiple baseline placements expose load excursions.
+    order = [config for r in range(args.rounds) for config in (args.compare if r % 2 == 0 else args.compare[::-1])]
+    report = {"protocol": {"order":order,"rounds":args.rounds,"baseline_max_min_ratio":1.25,
+                           "scope":"fresh release process; warm OS pages; same 10k BibTeX; no Zotero/cache changes"},
+              "fixture_sha256":manifest["files"]["library.bib"]["sha256"], "runs":[], "summaries":[]}
+    with args.output.open("x") as file:
+        json.dump(report, file, indent=2)
+    for config in order:
+        label, _, threads = config.partition(":")
+        load = os.getloadavg()
+        run = stage_a.measure(OUT / label / "storage_spike", environment(threads or "1"), stage_a.Memory())
+        run.update(config=config, records=10000, load_before=load, load_after=os.getloadavg())
+        run["rejections"] = stage_a.validate(run)
+        report["runs"].append(run)
+        args.output.write_text(json.dumps(report, indent=2) + "\n")
+        print(config, round(run.get("first_results_ms",0),1), run["rejections"], flush=True)
+    baseline = [r for r in report["runs"] if r["config"] == args.compare[0]]
+    report["baseline_validity"] = {m: max(r[m] for r in baseline) / min(r[m] for r in baseline)
+                                   for m in ["first_results_ms","peak_process_mib"]}
+    report["valid_comparison"] = all(x <= 1.25 for x in report["baseline_validity"].values()) and not any(r["rejections"] for r in report["runs"])
+    for config in args.compare:
+        runs = [r for r in report["runs"] if r["config"] == config]
+        report["summaries"].append({"config":config,
+            "metrics": {m:distribution([r[m] for r in runs]) for m in ["first_results_ms","first_search_ms","peak_process_mib","spawn_to_first_results_ms"]},
+            "stage_ms": {s:distribution([r["stages_ns"].get(s,0)/1e6 for r in runs]) for s in stage_a.STAGES}})
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report["summaries"], indent=2))
+
+
+if __name__ == "__main__":
+    main()

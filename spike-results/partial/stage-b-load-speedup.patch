+#[cfg(storage_spike_probe)]
+#[test]
+#[ignore = "probe hook cancels deterministically inside each real loading stage"]
+fn cancelled_stage_cannot_publish() {
+    for stage in ["read_copy", "parse", "normalize", "snapshot_fingerprints", "index"] {
+        let cancel = Cancellation::default();
+        let token = cancel.clone();
+        ibis_core::storage_spike_probe::hook(Some(Box::new(move |label| {
+            if label == stage { token.cancel(); }
+        })));
+        let session = FileCacheSession::default();
+        session.invalidate(1);
+        let original = empty();
+        let start = Instant::now();
+        let loaded = original.prepare_file_load(&input(), false, session.operation(1), &cancel);
+        ibis_core::storage_spike_probe::hook(None);
+        assert_eq!(loaded.err().unwrap().code, ErrorCode::Cancelled, "{stage}");
+        assert!(original.snapshot().unwrap().objects().is_empty(), "{stage} published");
+        println!("CANCEL {stage} {}ms", start.elapsed().as_millis());
+    }
+}

+//! Stage B oracles are captured once, before optimizing, and never refreshed
+//! by a comparison run. All fixtures contain invented data.
+use super::*;
+use ibis_engine::request::SearchRequest;
+use std::{path::PathBuf, sync::Arc, time::Duration};
+
+fn input() -> PathBuf {
+    PathBuf::from(std::env::var_os("IBIS_SPIKE_FIXTURE").unwrap()).join("library.bib")
+}
+
+fn oracle(engine: &Engine) -> Value {
+    let queries = [
+        "", "signals", "星図", "signlas", "müller", "mueller", "a:avery", "j:invented y:2001",
+        "\"signals\"", "quantum quasar", "10.1534/sp1534r41", "sp1534r9999", "β", "が", "abstract:signals",
+    ];
+    let searches: Vec<_> = queries.iter().map(|query| {
+        let result = engine.search(&SearchRequest { query: (*query).into(), limit: 50,
+            libraries: None, interpret_locator: false }, &Cancellation::default()).unwrap();
+        let hits: Vec<_> = result.hits.iter().map(|hit| json!([
+            hit.item.object.id().key, hit.score, hit.matched, hit.typo, hit.partial
+        ])).collect();
+        json!({"query":query,"hits":hits})
+    }).collect();
+    let mut samples = Vec::new();
+    for index in [0, 1, 2, 3, 4, 5, 9, 10, 41, 123, 4567, 9999] {
+        let key = format!("sp1534r{index}");
+        let shown = call(engine, Method::Show, json!({"item":{"by":"key","value":key}}));
+        let mut citations = Vec::new();
+        for style in ["apa", "chicago-author-date", "harvard-cite-them-right", "ieee", "modern-language-association"] {
+            let request = serde_json::from_value(json!({"keys":[{"key":key}],
+                "output":{"kind":"csl","style":style}})).unwrap();
+            let cited = engine.cite_keys(&request, &Cancellation::default()).unwrap();
+            let content = cited.copy_content(1).unwrap();
+            citations.push(json!({"style":style,"text":content.text,"html":content.html}));
+        }
+        samples.push(json!({"key":key,"show":shown,"citations":citations,"pandoc":cite(engine,1534,index,false)}));
+    }
+    let snapshot = engine.snapshot().unwrap();
+    json!({"searches":searches,"samples":samples,"snapshot":snapshot.fingerprints(),
+        "search_digest":Fingerprint::of_bytes(&serde_json::to_vec(&searches).unwrap())})
+}
+
+#[test]
+#[ignore = "10k fixture; stage_b.py captures the original once before optimization"]
+fn realistic_oracle() {
+    let engine = uncached(&input());
+    check_records(&engine, 10_000, 1534, false).unwrap();
+    let actual = serde_json::to_vec_pretty(&oracle(&engine)).unwrap();
+    let golden = PathBuf::from(std::env::var_os("IBIS_SPIKE_GOLDEN").unwrap());
+    if std::env::var_os("IBIS_SPIKE_CAPTURE").is_some() {
+        use std::io::Write;
+        std::fs::OpenOptions::new().write(true).create_new(true).open(golden).unwrap().write_all(&actual).unwrap();
+    } else {
+        assert_eq!(actual, std::fs::read(golden).unwrap(), "original search/show/cite/fingerprints changed");
+    }
+    let reopened = uncached(&input());
+    assert_eq!(oracle(&engine), oracle(&reopened), "close/reopen changed the result");
+}
+
+#[test]
+fn warning_lines_order_duplicates_and_hostile_bounds() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("invented.bib");
+    std::fs::write(&path, "@book{first,title={First}}\n@article{broken, title=\n@book{last,title={Last}}\n@book{dup,title={One}}\n@book{dup,title={Two}}\n").unwrap();
+    let loaded = ibis_sources::load_file(&path).unwrap();
+    assert_eq!(loaded.snapshot.objects().len(), 2);
+    assert_eq!(serde_json::to_value(&loaded.warnings).unwrap(), json!([
+        {"code":"syntax","line":2}, {"code":"duplicate-key","line":5}
+    ]));
+    assert!(loaded.snapshot.objects().iter().all(|item| item.object.id().key != "record:dup"));
+    // A tiny input describes an exponential macro expansion. The existing
+    // global byte/work/depth limits must refuse it before it materializes.
+    let mut hostile = "@string{a={xxxxxxxxxxxxxxxx}}\n".to_owned();
+    for n in 0..30 {
+        let previous = if n == 0 { "a".to_owned() } else { format!("s{}", n-1) };
+        hostile.push_str(&format!("@string{{s{n}={previous}#{previous}}}\n"));
+    }
+    hostile.push_str("@book{bounded,title=s29}\n");
+    std::fs::write(&path, hostile).unwrap();
+    let start = Instant::now();
+    let loaded = ibis_sources::load_file(&path).unwrap();
+    assert!(start.elapsed() < Duration::from_secs(2));
+    assert!(!loaded.warnings.is_empty());
+    assert!(serde_json::to_vec(&loaded.snapshot).unwrap().len() < 256 * 1024);
+}

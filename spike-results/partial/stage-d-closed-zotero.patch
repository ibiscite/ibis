+/// Each JSON request names only an invented private fixture under target/stage-d.
+#[test]
+#[ignore = "stage D JSON-lines worker, launched by tests/stage_d.py"]
+fn oracle_worker() {
+    for line in std::io::stdin().lock().lines() {
+        let request: Value = serde_json::from_str(&line.unwrap()).unwrap();
+        let path = PathBuf::from(request["path"].as_str().unwrap());
+        assert!(path.starts_with(Path::new(env!("CARGO_MANIFEST_DIR")).join("../../target/stage-d")));
+        let expected = read_private(Path::new(request["expected"].as_str().unwrap()), "full-clone", request["bbt"] == true).unwrap();
+        let mut outcomes = BTreeMap::new();
+        for mode in ["full-clone", "partial-clone"] {
+            let result = read_private(&path, mode, request["bbt"] == true);
+            let (outcome, reason) = match result {
+                Err(e) => ("refused", Some(format!("{e:?}"))),
+                Ok(s) if request["bbt"] == true && s.better_bibtex_unknown => ("refused", Some("keys-unknown".into())),
+                Ok(s) if s == expected => ("read correctly", None),
+                Ok(_) => ("wrong citation data", None),
+            };
+            outcomes.insert(mode, json!({"outcome":outcome,"reason":reason}));
+        }
+        println!("STAGE_D {}", json!({"name":request["name"],"outcomes":outcomes}));
+    }
+}

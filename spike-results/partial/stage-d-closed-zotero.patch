+/// Clone only from the verified open source handle. Never reopen its path,
+/// hard-link it, or skip the subsequent full byte comparison and sidecar fence.
+fn try_clone(source: &File, path: &Path) -> Result<bool, ClosedError> {
+    #[cfg(target_os = "macos")]
+    {
+        use rustix::fs::{CloneFlags, CWD, fclonefileat};
+        match fclonefileat(source, CWD, path, CloneFlags::NOFOLLOW | CloneFlags::NOOWNERCOPY) {
+            Ok(()) => return Ok(true),
+            Err(rustix::io::Errno::NOTSUP | rustix::io::Errno::XDEV | rustix::io::Errno::INVAL | rustix::io::Errno::NOSYS) => (),
+            Err(rustix::io::Errno::NOSPC | rustix::io::Errno::DQUOT) => return Err(ClosedError::NoSpace),
+            Err(_) => return Err(ClosedError::PrivateStorage),
+        }
+    }
+    #[cfg(target_os = "linux")]
+    {
+        let target = private_file(path)?;
+        match rustix::fs::ioctl_ficlone(&target, source) {
+            Ok(()) => return Ok(true),
+            Err(rustix::io::Errno::OPNOTSUPP | rustix::io::Errno::XDEV | rustix::io::Errno::INVAL | rustix::io::Errno::NOTTY | rustix::io::Errno::NOSYS) => (),
+            Err(rustix::io::Errno::NOSPC | rustix::io::Errno::DQUOT) => return Err(ClosedError::NoSpace),
+            Err(_) => return Err(ClosedError::PrivateStorage),
+        }
+        drop(target);
+        std::fs::remove_file(path).map_err(|_| ClosedError::PrivateStorage)?;
+    }
+    let _ = (source, path);
+    Ok(false)
+}

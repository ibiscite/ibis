+fn copy_source(source: &mut Source, path: &Path, control: &Control, left: &mut u64) -> Result<(), ClosedError> {
+    #[cfg(test)]
+    let _span = super::stage_d::Span::new("copy_including_sync");
+    control.check()?;
+    platform::passive(&source.file)?;
+    let length = source.metadata.len();
+    *left = left.checked_sub(length).ok_or(ClosedError::TooLarge)?;
+    let clone_enabled = true;
+    #[cfg(test)]
+    let clone_enabled = clone_enabled && !super::stage_d::streamed();
+    let cloned = clone_enabled && try_clone(&source.file, path)?;
+    control.check()?; // A clone syscall is synchronous, and cannot be interrupted mid-call.
+    let mut target = if cloned {
+        // Clone creates a different inode under the already private directory.
+        // Remove copied permissions/ACLs before any SQLite access.
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))
+                .map_err(|_| ClosedError::PrivateStorage)?;
+        }
+        // fclonefileat without CLONE_ACL inherits only our secured directory's ACL.
+        platform::secure_file(path, control)?;
+        OpenOptions::new().write(true).open(path).map_err(|_| ClosedError::PrivateStorage)?
+    } else {
+        private_file(path)?
+    };
+    if !cloned {
+        #[cfg(test)]
+        let _span = super::stage_d::Span::new("stream_bytes");
+        source.file.rewind().map_err(|_| ClosedError::Unreadable)?;
+        let mut remaining = length;
+        let mut buffer = vec![0; CHUNK];
+        while remaining > 0 {
+            control.check()?;
+            platform::passive(&source.file)?;
+            let n = remaining.min(CHUNK as u64) as usize;
+            source.file.read_exact(&mut buffer[..n]).map_err(|_| ClosedError::Changing)?;
+            target.write_all(&buffer[..n]).map_err(|_| ClosedError::NoSpace)?;
+            remaining -= n as u64;
+        }
+        if source.file.read(&mut buffer[..1]).map_err(|_| ClosedError::Changing)? != 0 {
+            return Err(ClosedError::Changing);
+        }
+    }
+    if target.metadata().map_err(|_| ClosedError::PrivateStorage)?.len() != length {
+        return Err(ClosedError::Changing);
+    }
+    {
+        #[cfg(test)]
+        let _span = super::stage_d::Span::new("file_sync");
+        target.sync_all().map_err(|_| ClosedError::PrivateStorage)?;
+    }
+    control.check()
+}

+    let began = Instant::now();
+    let ((result, native), trace) = run(&mode, || {
+        let control = tests::control();
+        let store = private_copy::Store::open(scratch.path(), &control).unwrap();
+        let result = store.read_with(&source, &control, &mut || Ok(()), &mut || Ok(()));
+        (result, "synthetic closed-process hook; native enumeration is sandbox-denied")
+    });
+    let elapsed = began.elapsed().as_secs_f64()*1000.0;
+    let snapshot = result.unwrap();
+    let items: Vec<_> = snapshot.libraries.iter().flat_map(|l| &l.items).collect();
+    assert!(items.iter().all(|i| i.data.fields["title"].contains("seed1534 ")));
+    println!("STAGE_D {}", json!({"mode":mode,"closed_read_ms":elapsed,"stages_ms":trace,"items":items.len(),"native":native}));
+}

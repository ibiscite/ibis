+fn cloned_copy_has_distinct_identity_and_bidirectional_write_isolation() {
+    use std::os::unix::fs::MetadataExt;
+    let source = fixture(10);
+    let original = source.path().join("zotero.sqlite");
+    let file = platform::open_source(&original).unwrap_or_else(|e| panic!("{e}"));
+    let scratch = scratch();
+    let target = scratch.path().join("clone");
+    if !try_clone(&file, &target).unwrap_or_else(|e| panic!("{e}")) {
+        return; // Other filesystems exercise the streamed fallback in normal tests.
+    }
+    assert_ne!(file.metadata().unwrap_or_else(|_| panic!("source stat")).ino(), std::fs::metadata(&target).unwrap_or_else(|_| panic!("clone stat")).ino());
+    let expected = std::fs::read(&target).unwrap_or_default();
+    let mut writer = OpenOptions::new().write(true).open(&original).unwrap_or_else(|_| panic!("source writer"));
+    writer.seek(SeekFrom::Start(200)).unwrap_or_else(|_| panic!("seek"));
+    writer.write_all(b"invented source change").unwrap_or_else(|_| panic!("write"));
+    assert_eq!(std::fs::read(&target).unwrap_or_default(), expected);
+    let source_after = std::fs::read(&original).unwrap_or_default();
+    let mut writer = OpenOptions::new().write(true).open(&target).unwrap_or_else(|_| panic!("clone writer"));
+    writer.seek(SeekFrom::Start(300)).unwrap_or_else(|_| panic!("seek"));
+    writer.write_all(b"invented private change").unwrap_or_else(|_| panic!("write"));
+    assert_eq!(std::fs::read(&original).unwrap_or_default(), source_after);

+#[test]
+fn partial_contract_refuses_new_dependencies_and_changed_schema() {
+    let source = tests::fixture(10);
+    let path = source.path().join("zotero.sqlite");
+    let mut db = Connection::open(&path).unwrap();
+    database::configure(&mut db, &tests::control()).unwrap();
+    partial_check(&mut db, false, &tests::control()).unwrap();
+    assert!(database::READ_SQL.iter().all(|sql| db.prepare(sql).is_ok()));
+    assert!(db.prepare("SELECT * FROM unanticipated_table").is_err());
+    drop(db);
+    tests::edit(source.path(), "CREATE TABLE unanticipated_table(x); INSERT INTO unanticipated_table VALUES('invented');");
+    let mut db = Connection::open(&path).unwrap();
+    database::configure(&mut db, &tests::control()).unwrap();
+    partial_check(&mut db, false, &tests::control()).unwrap();
+    assert!(db.prepare("SELECT * FROM unanticipated_table").is_err());
+    drop(db);
+    tests::edit(source.path(), "ALTER TABLE items ADD COLUMN unanticipated TEXT;");
+    let mut db = Connection::open(&path).unwrap();
+    database::configure(&mut db, &tests::control()).unwrap();
+    assert_eq!(partial_check(&mut db, false, &tests::control()), Err(ClosedError::Damaged));
+}

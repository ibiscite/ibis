+fn read_private(path: &Path, mode: &str, bbt: bool) -> Result<ClosedSnapshot, ClosedError> {
+    let copy = private_copy::Copy::fixture(path.to_owned());
+    let (result, _) = run(mode, || {
+        let control = tests::control();
+        let (mut snapshot, _) = database::read(&copy, &control)?;
+        if bbt { keys::attach(&copy, Some(7), false, &mut snapshot, &control)?; }
+        Ok(snapshot)
+    });
+    // Borrowed fixture directory is owned by the Python driver.
+    std::mem::forget(copy);
+    result
+}

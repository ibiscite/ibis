+//! Throwaway #1534 stage D. Partial checks are deliberately test-only.
+#![allow(clippy::unwrap_used)]
+use super::*;
+use rusqlite::{Connection, hooks::{AuthAction, AuthContext, Authorization}};
+use serde_json::{Value, json};
+use std::{cell::RefCell, collections::BTreeMap, io::BufRead, time::Instant};
+
+#[derive(Default)]
+struct Run {
+    mode: String,
+    ms: BTreeMap<&'static str, f64>,
+}
+thread_local! { static RUN: RefCell<Option<Run>> = const { RefCell::new(None) }; }
+
+pub(super) fn streamed() -> bool {
+    RUN.with_borrow(|r| r.as_ref().is_some_and(|r| r.mode == "full-stream"))
+}
+pub(super) struct Span(&'static str, Instant);
+impl Span {
+    pub(super) fn new(name: &'static str) -> Self { Self(name, Instant::now()) }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        RUN.with_borrow_mut(|r| {
+            if let Some(r) = r { *r.ms.entry(self.0).or_default() += self.1.elapsed().as_secs_f64() * 1000.0; }
+        });
+    }
+}
+
+fn run<T>(mode: &str, action: impl FnOnce() -> T) -> (T, BTreeMap<&'static str, f64>) {
+    RUN.with_borrow_mut(|r| { assert!(r.is_none()); *r = Some(Run { mode: mode.into(), ..Run::default() }); });
+    let result = action();
+    let trace = RUN.with_borrow_mut(|r| r.take().unwrap().ms);
+    (result, trace)
+}
+
+/// Return None outside an experiment: production always uses full quick_check.
+pub(super) fn check(db: &mut Connection, bbt: bool, control: &Control) -> Option<Result<(), ClosedError>> {
+    let partial = RUN.with_borrow(|r| r.as_ref().is_some_and(|r| r.mode.starts_with("partial")));
+    partial.then(|| partial_check(db, bbt, control))
+}
+
+fn normalize(sql: &str) -> String { sql.split_whitespace().collect::<String>().to_ascii_lowercase() }
+
+fn partial_check(db: &mut Connection, bbt: bool, control: &Control) -> Result<(), ClosedError> {
+    // These exact DDL contracts support ONLY the invented fixture schemas.
+    // Shipping would need independently reviewed contracts for supported Zotero/BBT schemas.
+    let fixture = include_str!("../../fixtures/closed/schema.sql");
+    let mut tables: Vec<(&str, String)> = if bbt {
+        vec![("citationkey", normalize("CREATE TABLE citationkey(itemID INTEGER PRIMARY KEY,itemKey TEXT,libraryID INTEGER,citationKey TEXT,pinned INTEGER)"))]
+    } else {
+        std::iter::once("version").chain(database::TABLES.iter().map(|(t, _)| *t))
+            .map(|t| {
+                let ddl = fixture.lines().find(|s| s.starts_with(&format!("CREATE TABLE {t}("))).unwrap();
+                (t, normalize(ddl.trim_end_matches(';')))
+            }).collect()
+    };
+    let settings: bool = db.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name='settings')", [], |r| r.get(0)).map_err(database::failure)?;
+    if !bbt && settings { tables.push(("settings", normalize("CREATE TABLE settings(setting TEXT,key TEXT,value TEXT,PRIMARY KEY(setting,key))"))); }
+    // Root aliases are cheap to reject, but do not detect shared child/overflow pages.
+    let duplicate: bool = db.query_row("SELECT EXISTS(SELECT rootpage FROM sqlite_schema WHERE rootpage>0 GROUP BY rootpage HAVING count(*)>1)", [], |r| r.get(0)).map_err(database::failure)?;
+    if duplicate { return Err(ClosedError::Damaged); }
+    for (table, expected) in &tables {
+        let sql: String = db.query_row("SELECT sql FROM sqlite_schema WHERE type='table' AND rootpage>0 AND name=?1", [table], |r| r.get(0)).map_err(database::failure)?;
+        if normalize(&sql) != *expected { return Err(ClosedError::Damaged); }
+        let triggers: bool = db.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE type='trigger' AND tbl_name=?1)", [table], |r| r.get(0)).map_err(database::failure)?;
+        if triggers { return Err(ClosedError::Damaged); }
+        let indexes: Vec<Option<String>> = db.prepare("SELECT sql FROM sqlite_schema WHERE type='index' AND tbl_name=?1").map_err(database::failure)?
+            .query_map([table], |r| r.get(0)).and_then(Iterator::collect::<rusqlite::Result<_>>).map_err(database::failure)?;
+        for sql in indexes.into_iter().flatten() {
+            if ![
+                "CREATE UNIQUE INDEX itemData_pk ON itemData(itemID,fieldID)",
+                "CREATE UNIQUE INDEX itemCreators_pk ON itemCreators(itemID,orderIndex)",
+                "CREATE UNIQUE INDEX deletedItems_pk ON deletedItems(itemID)",
+                "CREATE UNIQUE INDEX items_library_key ON items(libraryID,key)",
+            ].iter().any(|s| normalize(s) == normalize(&sql)) { return Err(ClosedError::Damaged); }
+        }
+    }
+    db.execute_batch("PRAGMA cell_size_check=ON").map_err(database::failure)?;
+    for table in std::iter::once("sqlite_schema").chain(tables.iter().map(|(t, _)| *t)) {
+        control.check()?;
+        // Table names come exclusively from the code contracts, never input SQL.
+        let check: String = db.query_row(&format!("PRAGMA main.quick_check('{table}')"), [], |r| r.get(0)).map_err(database::failure)?;
+        if check != "ok" { return Err(ClosedError::Damaged); }
+    }
+    let checked: Vec<String> = tables.into_iter().map(|(t, _)| t.into()).collect();
+    db.authorizer(Some(move |ctx: AuthContext<'_>| match ctx.action {
+        AuthAction::Read { table_name, .. } if ctx.accessor.is_some() ||
+            !checked.iter().any(|t| t == table_name) && !["sqlite_schema", "sqlite_master", "pragma_table_xinfo"].contains(&table_name) => Authorization::Deny,
+        _ => Authorization::Allow,
+    })).map_err(database::failure)?;
+    Ok(())
+}

+    path.write_text(path.read_text() + """
+/// Incomplete acquisition diagnostic; only ever opens the generated fixture.
+pub fn storage_memory_database_diagnostic(path: &Path) -> Result<ClosedSnapshot, ClosedError> {
+    database::storage_memory_read_path(path, &Control::new(Arc::new(|| false))).map(|(snapshot, _)| snapshot)
+}
+""")

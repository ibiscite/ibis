+//! Copied into the disposable workspace as an integration test by memory.py.
+#![allow(clippy::unwrap_used, unexpected_cfgs)]
+use ibis_core::{contract::*, storage_memory as mem};
+use ibis_engine::{Cancellation, Engine, Method};
+use serde_json::json;
+use std::{path::PathBuf, sync::Arc, time::Duration};
+
+#[cfg(storage_memory_counting)]
+#[global_allocator]
+static ALLOCATOR: mem::CountingSystem = mem::CountingSystem;
+
+fn pause() { std::thread::sleep(Duration::from_millis(300)); }
+
+#[test]
+#[ignore = "memory.py runs each case in a fresh release process with existing fixtures"]
+fn attributed_memory_scenario() {
+    let directory = PathBuf::from(std::env::var_os("IBIS_MEMORY_FIXTURE").unwrap());
+    let case = std::env::var("IBIS_MEMORY_CASE").unwrap();
+    let records: usize = std::env::var("IBIS_MEMORY_RECORDS").unwrap().parse().unwrap();
+    let typical: usize = std::env::var("IBIS_MEMORY_TYPICAL").unwrap().parse().unwrap();
+    mem::emit("harness_baseline", 0);
+    let engine = { let _guard = mem::span(1); Engine::new().unwrap().without_file_watches() };
+    let mut source = None;
+    {
+        let _guard = mem::span(1);
+        match case.as_str() {
+            "bib-none" => {
+                engine.dispatch(Method::Libraries, &json!({"action":"open-file","path":directory.join("library.bib")}), &Cancellation::default()).unwrap();
+            }
+            "zotero-lean" | "zotero-diagnostic" => {
+                let mut owner = ibis_sources::zotero_source::ZoteroSource::default();
+                let scratch = directory.parent().unwrap().join("stage-c-private-copy");
+                std::fs::create_dir_all(&scratch).unwrap();
+                let loaded = if case == "zotero-lean" {
+                    owner.storage_memory_closed(&directory.join("lean"), &scratch)
+                } else {
+                    owner.storage_memory_database_diagnostic(&directory.join("lean/zotero.sqlite"))
+                };
+                let loaded = match loaded {
+                    Ok(loaded) => loaded,
+                    Err(error) => { println!("MEMORY_REFUSED {error}"); return; }
+                };
+                for library in &loaded {
+                    engine.publish_library(library.library.clone(), Arc::new(library.snapshot.clone())).unwrap();
+                }
+                source = Some(owner);
+            }
+            _ => panic!("unknown case"),
+        }
+    }
+    let snapshot = engine.snapshot().unwrap();
+    assert_eq!(snapshot.objects().len(), records);
+    if let Some(source) = &source {
+        assert_eq!(source.current().len(), 1);
+        // The source owner, engine and index really share the object slice.
+        assert!(std::ptr::eq(source.current()[0].snapshot.objects().as_ptr(), snapshot.objects().as_ptr()));
+    }
+    let expected_key = if case == "bib-none" { format!("record:sp1534r{typical}") } else { format!("S{typical:07}") };
+    let typical_record = snapshot.objects().iter().find(|item| item.object.id().key == expected_key).unwrap();
+    let owner = mem::owner_of(typical_record.object.id().key.as_ptr());
+    let response = {
+        let _guard = mem::span(17);
+        engine.dispatch(Method::Search, &json!({"query":"signals","limit":50}), &Cancellation::default()).unwrap()
+    };
+    assert_eq!(response.data["hits"].as_array().unwrap().len(), 50);
+    pause();
+    mem::emit("first_response_retained_by_harness", owner);
+    drop(response);
+    drop(snapshot);
+    pause();
+    let settled = mem::emit("settled_after_response_drop", owner);
+    if cfg!(storage_memory_counting) {
+        // Independent allocator running counter versus a census of all live
+        // addresses and their tags. Neither a shared Arc nor a freed address
+        // can appear twice in this census.
+        let attributed: u64 = settled.buckets.iter().map(|bucket| bucket.bytes).sum();
+        assert!(attributed.abs_diff(settled.global_live_bytes) <= settled.global_live_bytes / 20,
+            "attribution drift exceeds 5%: {attributed} != {}", settled.global_live_bytes);
+        // These are lifetime claims, not an 'other' bucket hiding the gap.
+        for tag in [2, 17, 18, 19, 20] {
+            assert_eq!(settled.buckets[tag].bytes, 0, "unexpected retained {}", mem::LABELS[tag]);
+        }
+        let engine_bytes: u64 = settled.buckets[1..23].iter().map(|bucket| bucket.bytes).sum();
+        assert!(settled.buckets[1].bytes < engine_bytes / 20, "unclassified owner bookkeeping exceeds 5%");
+    }
+    let released = mem::pressure_relief();
+    println!("MEMORY_RELIEF {released}");
+    pause();
+    mem::emit("settled_after_pressure_relief", owner);
+    drop(engine);
+    drop(source);
+    pause();
+    mem::emit("all_ibis_owners_dropped", 0);
+    let released = mem::pressure_relief();
+    println!("MEMORY_RELIEF {released}");
+    pause();
+    mem::emit("all_dropped_after_pressure_relief", 0);
+}

+    binaries = {}
+    for mode in ["counted", "system"]:
+        args = ["cargo", "rustc", "--offline", "--locked", "--release", "-p", "ibis-engine", "--test", "storage_memory", "--message-format=json"]
+        if mode == "counted":
+            args += ["--", "--cfg", "storage_memory_counting"]
+        built = subprocess.run(args, cwd=OVERLAY, env=env, capture_output=True, text=True)
+        (ROOT / f"target/stage-c-build-{mode}.log").write_text(built.stderr)
+        if built.returncode:
+            raise RuntimeError(built.stderr)
+        artifacts = [json.loads(line) for line in built.stdout.splitlines()]
+        binary = next(Path(item["executable"]) for item in artifacts if item.get("reason") == "compiler-artifact" and item["target"]["name"] == "storage_memory" and item.get("executable"))
+        saved = ROOT / f"target/stage-c-{mode}"
+        shutil.copyfile(binary, saved)
+        saved.chmod(0o755)
+        binaries[mode] = saved
+    modified = sorted({patch["file"] for patch in patches} | {core + "lib.rs", sources + "zotero_source.rs", local + "closed.rs"})
+    return binaries, {"patches": patches, "sources": {name: {"original_sha256": digest(ROOT / name), "overlay_sha256": digest(OVERLAY / name)} for name in modified}, "binaries": {mode: digest(binary) for mode, binary in binaries.items()}}
+
+
+def typical_record(directory):
+    # Each generated entry occupies exactly one line. Select near the source
+    # mean, with an abstract and a common creator count.
+    entries = (directory / "library.bib").read_text().splitlines()
+    candidates = []
+    for index, entry in enumerate(entries):
+        if "abstract={" in entry and 1 <= entry.count(" and ") <= 5:
+            candidates.append((abs(len((entry + "\n").encode()) - 1024), index, len((entry + "\n").encode())))
+    _, index, length = min(candidates)
+    return index, length
+
+
+def run(binary, case, records, typical, nano):
+    env = {**os.environ, "IBIS_MEMORY_FIXTURE": str(ROOT / f"target/stage-a-fixtures/{records}"), "IBIS_MEMORY_CASE": case,
+           "IBIS_MEMORY_RECORDS": str(records), "IBIS_MEMORY_TYPICAL": str(typical)}
+    if nano == "off":
+        env["MallocNanoZone"] = "0"
+    result = subprocess.run([str(binary), "--exact", "attributed_memory_scenario", "--ignored", "--nocapture", "--test-threads=1"], env=env, capture_output=True, text=True, timeout=180)
+    samples = [json.loads(line.split("MEMORY_SAMPLE ", 1)[1]) for line in result.stdout.splitlines() if "MEMORY_SAMPLE " in line]
+    refused = [line.split("MEMORY_REFUSED ", 1)[1] for line in result.stdout.splitlines() if "MEMORY_REFUSED " in line]
+    return {"case": case, "records": records, "binary": binary.name, "nano": nano, "returncode": result.returncode,
+            "samples": samples, "refusals": refused, "stdout": result.stdout, "stderr": result.stderr}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--build-only", action="store_true")
+    parser.add_argument("--reuse-build", action="store_true")
+    args = parser.parse_args()
+    if platform.system() != "Darwin" or platform.machine() != "arm64" or os.sysconf("SC_PAGE_SIZE") != 16384:
+        raise RuntimeError("probe ABI is deliberately limited to macOS arm64, 16 KiB pages")
+    if args.reuse_build:
+        binaries = {mode: ROOT / f"target/stage-c-{mode}" for mode in ["counted", "system"]}
+        provenance = json.loads((ROOT / "target/stage-c-provenance.json").read_text())
+    else:
+        binaries, provenance = build()
+        (ROOT / "target/stage-c-provenance.json").write_text(json.dumps(provenance, indent=2) + "\n")
+    if args.build_only:
+        return
+    fixture = ROOT / "target/stage-a-fixtures/10000"
+    manifest = json.loads((fixture / "manifest.json").read_text())
+    for name in ["library.bib", "lean/zotero.sqlite"]:
+        if digest(fixture / name) != manifest["files"][name]["sha256"]:
+            raise RuntimeError(f"fixture hash changed: {name}")
+    typical, source_bytes = typical_record(fixture)
+    evidence = {"schema": 1, "stage": "C", "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                "revision": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
+                "platform": platform.platform(), "provenance": provenance, "fixture": manifest,
+                "typical": {"index": typical, "source_bytes": source_bytes}, "runs": []}
+    output = ROOT / "spike-results/stage-c-memory.json"
+    # Predeclared counterbalanced order; every attempt, including refusals, stays.
+    plan = [("counted", "bib-none", "default"), ("system", "bib-none", "default"),
+            ("system", "zotero-lean", "default"), ("counted", "zotero-lean", "default"),
+            ("counted", "zotero-diagnostic", "default"), ("system", "zotero-diagnostic", "default"),
+            ("system", "zotero-diagnostic", "off"), ("counted", "zotero-diagnostic", "off"),
+            ("system", "bib-none", "off"), ("counted", "bib-none", "off"),
+            ("system", "bib-none", "default"), ("counted", "bib-none", "default")]
+    evidence["plan"] = plan
+    for mode, case, nano in plan:
+        print(f"measuring {mode} {case} nano={nano}", flush=True)
+        evidence["runs"].append(run(binaries[mode], case, 10000, typical, nano))
+        output.write_text(json.dumps(evidence, indent=2) + "\n")
+    print(output)
+
+
+if __name__ == "__main__":
+    main()

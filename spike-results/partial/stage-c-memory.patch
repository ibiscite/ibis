+"""Stage C: exact live Rust allocations, unmodified System malloc, no dependencies.
+
+All source changes are in target/stage-c-source. Never generates fixtures or
+weakens the native acquisition checks. The explicitly named Zotero diagnostic
+uses the production SQLite decoder and mapper, but is NOT an acquisition run.
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[4]
+SUPPORT = Path(__file__).resolve().parent
+OVERLAY = ROOT / "target/stage-c-source"
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def build():
+    if OVERLAY.exists():
+        shutil.rmtree(OVERLAY)
+    OVERLAY.mkdir(parents=True)
+    for path in ROOT.iterdir():
+        if path.name in {"target", "crates", ".git", "spike-results", "Cargo.toml"}:
+            continue
+        (OVERLAY / path.name).symlink_to(path, target_is_directory=path.is_dir())

@@ -0,0 +1,283 @@
+//! Stage C overlay only. System allocations are forwarded unchanged: bookkeeping
+//! lives in a page-aligned BSS table, never in malloc blocks or allocation headers.
+//! The scenario separately runs without this global allocator to check RSS bias.
+#![allow(unsafe_code, clippy::missing_safety_doc, clippy::unwrap_used)]
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::{Cell, UnsafeCell};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+pub const LABELS: [&str; 24] = [
+    "harness/runtime",
+    "engine registry, maps and source owners",
+    "BibTeX parser/raw working set",
+    "CSL BTreeMap/Value object nodes",
+    "Record IDs, keys, aliases and identifier metadata",
+    "CSL map keys",
+    "CSL string values",
+    "CSL arrays",
+    "cite/full fingerprints",
+    "SnapshotObject Arc blocks",
+    "Snapshot shared object slice",
+    "SnapshotIndex entries and PreparedRecord Arc blocks",
+    "SnapshotIndex IDs and citation keys",
+    "SnapshotIndex identifiers",
+    "SnapshotIndex normalized metadata text",
+    "SnapshotIndex normalized abstracts",
+    "SnapshotIndex field bounds",
+    "search response/scratch",
+    "source read buffer",
+    "SourceSnapshot shared source text",
+    "Zotero closed raw working set",
+    "Zotero schema cache",
+    "watcher state",
+    "probe output",
+];
+const N: usize = 1 << 22;
+const PAGE: usize = 16384; // This experiment is macOS arm64, checked by runner.
+#[derive(Clone, Copy)]
+struct Slot {
+    ptr: usize,
+    // requested bytes (40), record owner (16), category (8).
+    packed: u64,
+}
+#[repr(align(16384))]
+struct Table(UnsafeCell<[Slot; N]>);
+// All access to the table is under LOCK. No allocator operation while locked.
+unsafe impl Sync for Table {}
+static TABLE: Table = Table(UnsafeCell::new([Slot { ptr: 0, packed: 0 }; N]));
+static LOCK: AtomicBool = AtomicBool::new(false);
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static LIVE: AtomicU64 = AtomicU64::new(0);
+static PEAK: AtomicU64 = AtomicU64::new(0);
+static ALLOCATED: AtomicU64 = AtomicU64::new(0);
+static FREED: AtomicU64 = AtomicU64::new(0);
+thread_local! {
+    static TAG: Cell<u8> = const { Cell::new(0) };
+    static OWNER: Cell<u16> = const { Cell::new(0) };
+    static NEXT_OWNER: Cell<u16> = const { Cell::new(0) };
+}
+unsafe extern "C" {
+    fn malloc_size(ptr: *const u8) -> usize;
+    fn mincore(address: *mut u8, length: usize, vector: *mut u8) -> i32;
+    fn malloc_zone_statistics(zone: *mut u8, stats: *mut MallocStats);
+    fn malloc_zone_pressure_relief(zone: *mut u8, goal: usize) -> usize;
+    fn proc_pidinfo(pid: i32, flavor: i32, arg: u64, buffer: *mut u8, size: i32) -> i32;
+}
+struct Lock;
+impl Lock {
+    fn take() -> Self {
+        while LOCK.compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {
+            std::hint::spin_loop();
+        }
+        Self
+    }
+}
+impl Drop for Lock {
+    fn drop(&mut self) {
+        LOCK.store(false, Ordering::Release);
+    }
+}
+fn find(table: &[Slot; N], ptr: usize) -> (usize, bool) {
+    let mut index = ((ptr >> 4).wrapping_mul(0x9e3779b97f4a7c15) >> 32) & (N - 1);
+    let mut tombstone = None;
+    for _ in 0..N {
+        match table[index].ptr {
+            0 => return (tombstone.unwrap_or(index), false),
+            1 => { tombstone.get_or_insert(index); }
+            value if value == ptr => return (index, true),
+            _ => (),
+        }
+        index = (index + 1) & (N - 1);
+    }
+    (tombstone.unwrap_or_else(|| std::process::abort()), false)
+}
+fn add(ptr: *mut u8, size: usize) {
+    if ptr.is_null() { return; }
+    ACTIVE.store(true, Ordering::Relaxed);
+    let tag = TAG.try_with(Cell::get).unwrap_or(0);
+    let owner = OWNER.try_with(Cell::get).unwrap_or(0);
+    if size >= 1 << 40 { std::process::abort(); }
+    let _lock = Lock::take();
+    // SAFETY: protected by the allocator-independent spin lock.
+    let table = unsafe { &mut *TABLE.0.get() };
+    let (index, found) = find(table, ptr as usize);
+    if found { std::process::abort(); }
+    table[index] = Slot { ptr: ptr as usize, packed: ((size as u64) << 24) | ((owner as u64) << 8) | tag as u64 };
+    let live = LIVE.fetch_add(size as u64, Ordering::Relaxed) + size as u64;
+    PEAK.fetch_max(live, Ordering::Relaxed);
+    ALLOCATED.fetch_add(size as u64, Ordering::Relaxed);
+}
+fn remove(ptr: *mut u8, size: usize) {
+    let _lock = Lock::take();
+    // SAFETY: protected by LOCK; the pointer has not been freed yet.
+    let table = unsafe { &mut *TABLE.0.get() };
+    let (index, found) = find(table, ptr as usize);
+    if !found || table[index].packed >> 24 != size as u64 { std::process::abort(); }
+    table[index].ptr = 1;
+    LIVE.fetch_sub(size as u64, Ordering::Relaxed);
+    FREED.fetch_add(size as u64, Ordering::Relaxed);
+}
+pub struct CountingSystem;
+// SAFETY: every System operation receives its original pointer and Layout.
+// The table neither changes requested sizes nor uses malloc for bookkeeping.
+unsafe impl GlobalAlloc for CountingSystem {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let ptr = unsafe { System.alloc(layout) };
+        add(ptr, layout.size());
+        ptr
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        add(ptr, layout.size());
+        ptr
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        remove(ptr, layout.size());
+        unsafe { System.dealloc(ptr, layout) };
+    }
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        // System::realloc failure leaves the old allocation intact.
+        let next = unsafe { System.realloc(ptr, layout, size) };
+        if !next.is_null() {
+            remove(ptr, layout.size());
+            add(next, size);
+        }
+        next
+    }
+}
+pub struct Span { tag: u8, owner: u16 }
+pub fn span(tag: u8) -> Span {
+    Span { tag: TAG.with(|value| value.replace(tag)), owner: OWNER.with(Cell::get) }
+}
+pub fn record() -> Span {
+    let guard = span(3);
+    let owner = NEXT_OWNER.with(|value| { let next = value.get().checked_add(1).unwrap(); value.set(next); next });
+    OWNER.with(|value| value.set(owner));
+    guard
+}
+pub fn owned(tag: u8, owner: u16) -> Span {
+    let guard = span(tag);
+    OWNER.with(|value| value.set(owner));
+    guard
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        TAG.with(|value| value.set(self.tag));
+        OWNER.with(|value| value.set(self.owner));
+    }
+}
+pub fn owner_of(ptr: *const u8) -> u16 {
+    if !ACTIVE.load(Ordering::Relaxed) { return 0; }
+    let _lock = Lock::take();
+    let table = unsafe { &*TABLE.0.get() };
+    let (index, found) = find(table, ptr as usize);
+    if found { ((table[index].packed >> 8) & 0xffff) as u16 } else { 0 }
+}
+pub fn mark(ptr: *const u8, tag: u8) {
+    if !ACTIVE.load(Ordering::Relaxed) { return; }
+    let _lock = Lock::take();
+    let table = unsafe { &mut *TABLE.0.get() };
+    let (index, found) = find(table, ptr as usize);
+    if found {
+        let owner = OWNER.with(Cell::get) as u64;
+        table[index].packed = (table[index].packed & !0xffffff) | (owner << 8) | tag as u64;
+    }
+}
+pub fn string(value: &String, tag: u8) {
+    if value.capacity() > 0 { mark(value.as_ptr(), tag); }
+}
+pub fn vector<T>(value: &Vec<T>, tag: u8) {
+    if value.capacity() > 0 && std::mem::size_of::<T>() > 0 { mark(value.as_ptr().cast(), tag); }
+}
+pub fn visit_record(record: &crate::contract::Record) {
+    mark(record.id.library.as_str().as_ptr(), 4);
+    string(&record.id.key, 4);
+    vector(&record.citation_keys, 4);
+    for key in &record.citation_keys { string(&key.value, 4); }
+    vector(&record.aliases, 4);
+    for alias in &record.aliases { string(alias, 4); }
+    vector(&record.identifiers, 4);
+    for (key, value) in &record.csl { string(key, 5); visit_value(value); }
+}
+fn visit_value(value: &serde_json::Value) {
+    use serde_json::Value;
+    match value {
+        Value::String(value) => string(value, 6),
+        Value::Array(values) => { vector(values, 7); for value in values { visit_value(value); } }
+        Value::Object(values) => { for (key, value) in values { string(key, 5); visit_value(value); } }
+        _ => (),
+    }
+}
+#[derive(Clone, Copy, Default, serde::Serialize)]
+pub struct Bucket { pub bytes: u64, pub allocations: u64, pub malloc_bytes: u64 }
+#[derive(Clone, Copy, Default, serde::Serialize)]
+#[repr(C)]
+pub struct MallocStats {
+    pub blocks_in_use: u32,
+    pub size_in_use: usize,
+    pub max_size_in_use: usize,
+    pub size_allocated: usize,
+}
+#[derive(serde::Serialize)]
+pub struct Sample {
+    pub label: &'static str,
+    pub rss_bytes: u64,
+    pub probe_table_resident_bytes: usize,
+    pub global_live_bytes: u64,
+    pub global_peak_live_bytes: u64,
+    pub cumulative_allocated_bytes: u64,
+    pub cumulative_freed_bytes: u64,
+    pub buckets: [Bucket; 24],
+    pub typical_record: [Bucket; 24],
+    pub malloc: MallocStats,
+}
+pub fn sample(label: &'static str, typical_owner: u16) -> Sample {
+    let mut buckets = [Bucket::default(); 24];
+    let mut typical_record = [Bucket::default(); 24];
+    let lock = Lock::take();
+    if ACTIVE.load(Ordering::Relaxed) {
+        for slot in unsafe { &*TABLE.0.get() } {
+            if slot.ptr > 1 {
+                let tag = (slot.packed & 255) as usize;
+                let owner = ((slot.packed >> 8) & 0xffff) as u16;
+                let bytes = slot.packed >> 24;
+                let malloc_bytes = unsafe { malloc_size(slot.ptr as *const u8) } as u64;
+                buckets[tag].bytes += bytes;
+                buckets[tag].allocations += 1;
+                buckets[tag].malloc_bytes += malloc_bytes;
+                if owner != 0 && owner == typical_owner {
+                    typical_record[tag].bytes += bytes;
+                    typical_record[tag].allocations += 1;
+                    typical_record[tag].malloc_bytes += malloc_bytes;
+                }
+            }
+        }
+    }
+    let live = LIVE.load(Ordering::Relaxed);
+    drop(lock);
+    let mut resident = [0_u8; N * std::mem::size_of::<Slot>() / PAGE];
+    let table_resident = if ACTIVE.load(Ordering::Relaxed) {
+        let result = unsafe { mincore(TABLE.0.get().cast(), std::mem::size_of_val(&TABLE), resident.as_mut_ptr()) };
+        assert_eq!(result, 0);
+        resident.iter().filter(|byte| **byte & 1 != 0).count() * PAGE
+    } else { 0 };
+    let mut malloc = MallocStats::default();
+    unsafe { malloc_zone_statistics(std::ptr::null_mut(), &mut malloc) };
+    let mut task = [0_u64; 12];
+    let count = unsafe { proc_pidinfo(std::process::id() as i32, 4, 0, task.as_mut_ptr().cast(), 96) };
+    assert_eq!(count, 96);
+    Sample { label, rss_bytes: task[1], probe_table_resident_bytes: table_resident,
+        global_live_bytes: live, global_peak_live_bytes: PEAK.load(Ordering::Relaxed),
+        cumulative_allocated_bytes: ALLOCATED.load(Ordering::Relaxed), cumulative_freed_bytes: FREED.load(Ordering::Relaxed),
+        buckets, typical_record, malloc }
+}
+pub fn emit(label: &'static str, typical_owner: u16) -> Sample {
+    let result = sample(label, typical_owner);
+    let _guard = span(23);
+    println!("MEMORY_SAMPLE {}", serde_json::to_string(&result).unwrap());
+    result
+}
+pub fn pressure_relief() -> usize {
+    unsafe { malloc_zone_pressure_relief(std::ptr::null_mut(), 0) }
+}

+    (OVERLAY / "Cargo.toml").write_text((ROOT / "Cargo.toml").read_text().replace('unsafe_code = "forbid"', 'unsafe_code = "deny"'))
+    shutil.copytree(ROOT / "crates", OVERLAY / "crates", ignore=shutil.ignore_patterns("__pycache__"))
+    patches = []
+
+    def replace(path, before, after):
+        target = OVERLAY / path
+        text = target.read_text()
+        if text.count(before) != 1:
+            raise RuntimeError(f"anchor mismatch in {path}: {before[:90]}")
+        target.write_text(text.replace(before, after))
+        patches.append({"file": path, "before": before, "after": after})
+
+    def entry(path, anchor, tag, core=False):
+        module = "crate" if core else "ibis_core"
+        replace(path, anchor, anchor + f"\n    let _memory_span = {module}::storage_memory::span({tag});")
+
+    core = "crates/ibis-core/src/"
+    sources = "crates/ibis-sources/src/"
+    local = "crates/ibis-zotero-local/src/"
+    path = OVERLAY / core / "lib.rs"
+    path.write_text(path.read_text() + "\n#[doc(hidden)]\n#[allow(unsafe_code)]\npub mod storage_memory;\n")
+    shutil.copyfile(SUPPORT / "memory_probe.rs", OVERLAY / core / "storage_memory.rs")
+    shutil.copyfile(SUPPORT / "memory_scenario.rs", OVERLAY / "crates/ibis-engine/tests/storage_memory.rs")
+    entry(sources + "bibtex/mod.rs", ") -> (ParsedLibrary, bool) {", 2)
+    entry(sources + "file.rs", "fn read_text(file: impl Read) -> Result<String, SourceError> {", 18)
+    replace(sources + "file.rs", "            text: text.into(),", "            text: { let _guard = ibis_core::storage_memory::span(19); text.into() },")
+    replace(sources + "bibtex/convert.rs", ") -> Record {", ") -> Record {\n    let _memory_record = ibis_core::storage_memory::record();")
+    replace(sources + "bibtex/convert.rs", "    Record {\n        id: ItemRef {", "    let record = Record {\n        id: ItemRef {")
+    replace(sources + "bibtex/convert.rs", "            .collect(),\n    }\n}\n\nfn name_json", "            .collect(),\n    };\n    ibis_core::storage_memory::visit_record(&record);\n    record\n}\n\nfn name_json")
+    replace(sources + "zotero/mod.rs", "pub fn map_item(library: LibraryId, item: &ZoteroItem) -> Result<MappedItem, MappingError> {", "pub fn map_item(library: LibraryId, item: &ZoteroItem) -> Result<MappedItem, MappingError> {\n    let _memory_record = ibis_core::storage_memory::record();")
+    entry(sources + "zotero/mod.rs", "fn schema() -> Result<&'static Schema, MappingError> {", 21)
+    replace(sources + "zotero/mod.rs", "    Ok(MappedItem {\n        record: Record {", "    let mapped = MappedItem {\n        record: Record {")
+    replace(sources + "zotero/mod.rs", "        warnings,\n    })\n}\n\nfn validate", "        warnings,\n    };\n    ibis_core::storage_memory::visit_record(&mapped.record);\n    Ok(mapped)\n}\n\nfn validate")
+    entry(core + "contract/model.rs", "    fn fingerprints(&self) -> Result<Fingerprints, ModelError> {", 8, True)
+    replace(core + "contract/model.rs", "                let fingerprints = object.fingerprints()?;", "                let _memory_owner = crate::storage_memory::owned(9, crate::storage_memory::owner_of(object.id().key.as_ptr()));\n                let fingerprints = object.fingerprints()?;")
+    replace(core + "contract/model.rs", "            objects: objects.into(),", "            objects: { let _guard = crate::storage_memory::span(10); objects.into() },")
+    entry(core + "search/snapshot.rs", "    fn build(snapshot: Arc<Snapshot>, previous: Option<&Self>) -> Self {", 11, True)
+    replace(core + "search/snapshot.rs", "                let keys: Vec<_> = record", "                let _memory_owner = crate::storage_memory::owned(11, crate::storage_memory::owner_of(record.id.key.as_ptr()));\n                let keys: Vec<_> = record")
+    replace(core + "search/snapshot.rs", "        Self {\n            snapshot,\n            entries,\n            texts: texts.shrink(),\n        }", """        let index = Self { snapshot, entries, texts: texts.shrink() };
+        crate::storage_memory::vector(&index.entries, 11);

[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Find references in the user's library by author, title words, year or key. Every citation needs a ref from here.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "An author surname, title words, a year or a key.",
          "minLength": 1,
          "type": "string"
        },
        "shorthand": {
          "description": "Read \"see\" before and \"417\" after the words into cited_with.",
          "type": "boolean"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "search",
    "outputSchema": {
      "oneOf": [
        {
          "properties": {
            "cited_with": {
              "type": "object"
            },
            "complete": {
              "type": "boolean"
            },
            "hits": {
              "items": {
                "properties": {
                  "authors": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "container": {},
                  "doi": {},
                  "partial": {
                    "type": "boolean"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "title": {},
                  "type": {},
                  "typo": {
                    "type": "boolean"
                  },
                  "year": {}
                },
                "required": [
                  "ref",
                  "partial",
                  "typo"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "library_notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "missing": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "provenance": {
              "type": "string"
            },
            "searched_for": {
              "type": "string"
            },
            "source_health": {
              "type": "object"
            }
          },
          "required": [
            "hits",
            "complete",
            "provenance",
            "source_health"
          ]
        },
        {
          "properties": {
            "error": {
              "required": [
                "code",
                "message",
                "recovery",
                "focus"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "type": "object"
    },
    "title": "Search references"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read a reference's fields (pages, publisher, identifiers) by ref. Not needed before citing.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "description": "A ref from search.",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "show",
    "outputSchema": {
      "oneOf": [
        {
          "properties": {
            "authors": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "container": {},
            "doi": {},
            "fields": {
              "type": "object"
            },
            "library_notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "provenance": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "source_health": {
              "type": "object"
            },
            "title": {},
            "type": {},
            "year": {}
          },
          "required": [
            "ref",
            "fields",
            "provenance",
            "source_health"
          ]
        },
        {
          "properties": {
            "error": {
              "required": [
                "code",
                "message",
                "recovery",
                "focus"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "type": "object"
    },
    "title": "Show a reference"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Cite refs from search, in order, with optional locators. Use the returned text unchanged and tell the user about notices, losses and warnings.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "for_app": {
          "description": "A macOS bundle ID or Windows executable: use the output Ibis uses there.",
          "type": "string"
        },
        "form": {
          "description": "bibliography-only writes reference-list entries.",
          "enum": [
            "normal",
            "narrative",
            "author-only",
            "year-only",
            "full",
            "bibliography-only"
          ],
          "type": "string"
        },
        "format": {
          "description": "Citation keys for a document processor, instead of style.",
          "enum": [
            "pandoc",
            "pandoc-bare",
            "autocite",
            "parencite",
            "textcite",
            "natbib",
            "cite",
            "context",
            "typst",
            "org-cite",
            "myst",
            "multi-markdown",
            "ascii-doc",
            "jupyter",
            "jekyll-scholar",
            "cayw-json",
            "keys"
          ],
          "type": "string"
        },
        "include_receipt": {
          "description": "Add the audit receipt: hashes of the request, formatter and sources.",
          "type": "boolean"
        },
        "items": {
          "description": "The references, in order.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "locator": {
                "description": "Such as \"p. 12\", \"ch. 3\" or \"12-14\".",
                "type": "string"
              },
              "omit_author": {
                "description": "The sentence already names the author.",
                "type": "boolean"
              },
              "prefix": {
                "description": "Such as \"see\".",
                "type": "string"
              },
              "ref": {
                "description": "A ref from search.",
                "type": "string"
              },
              "suffix": {
                "description": "Text after this item.",
                "type": "string"
              }
            },
            "required": [
              "ref"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "keep_order": {
          "description": "Keep this order where a style would sort.",
          "type": "boolean"
        },
        "locale": {
          "description": "A style's language, such as de-DE.",
          "type": "string"
        },
        "records": {
          "description": "Instead of items: CSL-JSON objects with id and type.",
          "items": {
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "strict": {
          "description": "Refuse losses, refusals or source problems.",
          "type": "boolean"
        },
        "style": {
          "description": "A CSL style id, such as apa, ieee or one from styles. Default: apa.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "cite",
    "outputSchema": {
      "oneOf": [
        {
          "properties": {
            "bibliography": {
              "type": "object"
            },
            "destination": {
              "type": "object"
            },
            "language": {
              "type": "string"
            },
            "library_notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "losses": {
              "type": "array"
            },
            "notices": {
              "type": "array"
            },
            "provenance": {
              "type": "string"
            },
            "receipt": {
              "type": "object"
            },
            "source_health": {
              "type": "object"
            },
            "text": {
              "type": "string"
            },
            "warnings": {
              "type": "array"
            }
          },
          "required": [
            "text",
            "notices",
            "losses",
            "provenance",
            "source_health"
          ]
        },
        {
          "properties": {
            "error": {
              "required": [
                "code",
                "message",
                "recovery",
                "focus"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "type": "object"
    },
    "title": "Format a citation"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Find CSL style ids by journal or style name, and the locales cite accepts.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 25,
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "description": "Styles to skip, for the next page.",
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "description": "Words from a journal or style name.",
          "maxLength": 1024,
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "styles",
    "outputSchema": {
      "oneOf": [
        {
          "properties": {
            "locales": {
              "type": "array"
            },
            "styles": {
              "items": {
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "updated": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "updated"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "styles",
            "total",
            "locales"
          ]
        },
        {
          "properties": {
            "error": {
              "required": [
                "code",
                "message",
                "recovery",
                "focus"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "type": "object"
    },
    "title": "Find citation styles"
  }
]

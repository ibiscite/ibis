  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Cite refs from search, in order, with optional locators. Use the returned text unchanged and tell the user about notices, losses and warnings.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "for_app": {
          "description": "A macOS bundle ID or Windows executable: use the output Ibis uses there.",
          "type": "string"
        },
        "form": {
          "description": "narrative: one reference, one author in APA-like styles, no numbered styles. bibliography-only: entries.",
          "enum": [
            "normal",
            "narrative",
            "author-only",
            "year-only",
            "full",
            "bibliography-only"
          ],
          "type": "string"
        },
        "format": {
          "description": "Citation keys for a document processor, instead of style.",
          "enum": [
            "pandoc",
            "pandoc-bare",
            "autocite",
            "parencite",
            "textcite",
            "natbib",
            "cite",
            "context",
            "typst",
            "org-cite",
            "myst",
            "multi-markdown",
            "ascii-doc",
            "jupyter",
            "jekyll-scholar",
            "cayw-json",
            "keys"
          ],
          "type": "string"
        },
        "include_receipt": {
          "description": "Add the audit receipt: hashes of the request, formatter and sources.",
          "type": "boolean"
        },
        "items": {
          "description": "The references, in order.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "locator": {
                "description": "Such as \"p. 12\", \"ch. 3\" or \"12-14\".",
                "type": "string"
              },
              "omit_author": {
                "description": "The sentence already names the author.",
                "type": "boolean"
              },
              "prefix": {
                "description": "Such as \"see\".",
                "type": "string"
              },
              "ref": {
                "description": "A ref from search.",
                "type": "string"
              },
              "suffix": {
                "description": "Text after this item.",
                "type": "string"
              }
            },
            "required": [
              "ref"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "keep_order": {
          "description": "Keep this order where a style would sort.",
          "type": "boolean"
        },
        "locale": {
          "description": "A style's language, such as de-DE.",
          "type": "string"
        },
        "records": {
          "description": "Instead of items: CSL-JSON objects with id and type.",
          "items": {
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "strict": {
          "description": "Refuse losses, refusals or source problems.",
          "type": "boolean"
        },
        "style": {
          "description": "A CSL style id, such as apa, ieee or one from styles. Default: apa.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "cite",
    "outputSchema": {
      "oneOf": [
        {
          "properties": {
            "bibliography": {
              "type": "object"
            },
            "destination": {
              "type": "object"
            },
            "language": {
              "type": "string"
            },
            "library_notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "losses": {
              "type": "array"
            },
            "notices": {
              "type": "array"
            },
            "provenance": {
              "type": "string"
            },
            "receipt": {
              "type": "object"
            },
            "source_health": {
              "type": "object"
            },
            "text": {
              "type": "string"
            },
            "warnings": {
              "type": "array"
            }
          },
          "required": [
            "text",
            "notices",
            "losses",
            "provenance",
            "source_health"
          ]
        },
        {
          "properties": {
            "error": {
              "required": [
                "code",
                "message",
                "recovery",
                "focus"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      ],
      "type": "object"
    },
    "title": "Format a citation"
  },
  {
    "annotations": {

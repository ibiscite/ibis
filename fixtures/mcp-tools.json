                "properties": {
                  "authors": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "container": {},
                  "doi": {},
                  "partial": {
                    "type": "boolean"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "title": {},
                  "type": {},
                  "typo": {
                    "type": "boolean"
                  },
                  "year": {}
                },
                "required": [
                  "ref",
                  "partial",
                  "typo"

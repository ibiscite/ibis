                "type": "object"
              },
              "type": "array"
            },
            "library_notes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "missing": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "provenance": {
              "type": "string"
            },
            "searched_for": {
              "type": "string"
            },
            "source_health": {
              "type": "object"
            }
          },
          "required": [
            "hits",
            "complete",
            "provenance",
            "source_health"
          ]
        },
        {
          "properties": {
            "error": {
              "required": [
                "code",
                "message",
                "recovery",
                "focus"
              ],
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
